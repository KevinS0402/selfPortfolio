# Copy to .env.local locally. Set production values privately in Vercel.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Kevin Song <contact@kevinsong.dev>"
CONTACT_TO_EMAIL=kevin.song.1@vanderbilt.edu
# Google reCAPTCHA v2 checkbox: secret stays server-side; site key is public.
RECAPTCHA_SECRET_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Optional comma-separated exact origins for controlled testing; no wildcards.
CONTACT_ALLOWED_ORIGINS=

# PostHog: public project token and ingestion host, never a personal API key.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
# Controlled local QA only; production is enabled through VERCEL_ENV=production.
POSTHOG_LOCAL_TEST=0
